{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "eCTD Viewer (Debug)",
            "type": "cppdbg",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/target/debug/ectd-viewer",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${env:HOME}/.cargo/bin/rust-gdb",
            "preLaunchTask": "cargo build (debug)",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "eCTD Viewer (Release)",
            "type": "cppdbg",
            "request": "launch",
            "args": [],
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/target/release/ectd-viewer",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${env:HOME}/.cargo/bin/rust-gdb",
            "preLaunchTask": "cargo build (release)",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "eCTD Tool (Debug)",
            "type": "cppdbg",
            "request": "launch",
            "args": [
                "${input:dossierPath}",
                "${input:sequence}"
            ],
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/target/debug/ectd-tool",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "${env:HOME}/.cargo/bin/rust-gdb",
            "preLaunchTask": "cargo build (debug)",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "dossierPath",
            "type": "promptString",
            "description": "Dossierordner mit Metadaten und Sequenzverzeichnissen"
        },
        {
            "id": "sequence",
            "type": "promptString",
            "description": "Sequenznummer",
            "default": "0001"
        }
    ]
}
